{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phoibe/factory/main/schema/factory.config.schema.json",
  "title": "Règles de la factory",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "runner": { "enum": ["claude-cloud", "github-actions"], "description": "Où tournent les agents" },
    "maxParallel": { "type": "integer", "minimum": 1, "description": "Features en parallèle" },
    "maxQuestions": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Features piochées par la factory qui peuvent attendre les réponses du propriétaire en même temps" },
    "autoPick": { "type": "boolean", "description": "Piocher automatiquement dans les fiches existantes quand des places sont libres" },
    "stack": { "type": "string", "description": "Stack technique par défaut" },
    "siteUrl": { "type": "string", "pattern": "^https://\\S+$", "description": "Adresse du site en ligne" },
    "production": { "enum": ["auto", "approval", "external"], "description": "Mise en production : automatique, sur accord du propriétaire (bouton « Mise en production »), ou externe (faite hors de la factory, qui s'arrête au merge). Absent : selon la fiche stack." },
    "stages": {
      "type": "object",
      "properties": {
        "grilling": { "type": "boolean" }, "specReview": { "type": "boolean" }, "plan": { "type": "boolean" }, "tdd": { "type": "boolean" },
        "review": { "type": "boolean" }, "designPass": { "type": "boolean" }, "screenshots": { "type": "boolean" },
        "checks": { "type": "boolean" }, "acceptance": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review": { "type": "object", "properties": { "maxLoops": { "type": "integer", "minimum": 1 } } },
    "checks": {
      "type": "object",
      "properties": {
        "typecheck": { "type": "boolean" }, "lint": { "type": "boolean" }, "test": { "type": "boolean" },
        "build": { "type": "boolean" }, "a11y": { "type": "boolean" }, "e2e": { "type": "boolean" }, "audit": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "extraChecks": {
      "type": "array", "maxItems": 10,
      "description": "Contrôles propres au projet, joués après les contrôles habituels : un nom, la commande lancée à la racine du projet, un interrupteur.",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "command": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]*$" },
          "enabled": { "type": "boolean" }
        },
        "required": ["label", "command"],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "skills": { "type": "object", "additionalProperties": { "type": "boolean" } }
        }
      }
    }
  }
}
