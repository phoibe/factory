#!/usr/bin/env bash
# Accounts of the fake server: the owner, factory-runner once created, and those listed in $FAKE/users/<name>
# (the file holds the account's groups).
case "${1:-}" in
  -u) echo "${FAKE_UID:-1000}" ;;
  -un) echo "${FAKE_USER:-pierre}" ;;
  -nG) if [ -f "$FAKE/users/$2" ]; then cat "$FAKE/users/$2"; else echo "$2"; fi ;;
  '') echo "uid=1000(pierre)" ;;
  factory-runner) [ -f "$FAKE/user-created" ] ;;
  *) [ "$1" = "${FAKE_USER:-pierre}" ] || [ -f "$FAKE/users/$1" ] ;;
esac
